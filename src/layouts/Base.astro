---
import Nav from '../components/Nav';
import Smooth from '../components/Smooth';
import { Link2, Globe, ArrowUpRight, Send, Camera } from 'lucide-react';
import '../styles/site.css';
import '../styles/fun.css';
import '../styles/theme-light.css';
import '@fontsource-variable/montserrat';
import '@fontsource/barlow-condensed/900-italic.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '../styles/type.css';
interface Props { title: string; desc: string; current?: string; og?: string; total?: number; footer?: boolean; schema?: object; noindex?: boolean; footerClass?: string }
const { title, desc, current, og, total, footer = true, schema, noindex = false, footerClass = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImg = new URL(og ?? '/assets/yohan-campaign-coordinator.webp', Astro.site).href;
const WORDS = ['Ideate', 'Create', 'Execute', 'Published', 'Brand', 'Campaigns', 'Culture'];
const COLS = ['#C8FF00', '#F2EDE4', '#FF3D00'];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <link rel="canonical" href={canonical} />
  <meta property="og:url" content={canonical} /><meta property="og:type" content="website" /><meta property="og:image" content={ogImg} />
  <meta name="twitter:card" content="summary_large_image" />
  {noindex && <meta name="robots" content="noindex" />}
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='32' fill='%23C8FF00'/%3E%3Ctext x='32' y='42' font-family='Impact,sans-serif' font-size='30' font-style='italic' text-anchor='middle' fill='%23070707'%3EYW%3C/text%3E%3C/svg%3E" />
  <noscript><style>[style*="opacity: 0"]{opacity:1!important;transform:none!important}</style></noscript>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Smooth client:load />
  <Nav client:load current={current} total={total} />
  <main id="main"><slot /></main>
  {footer && (
    <footer class={`foot ${footerClass}`}>
      <div class="ribbon" aria-hidden="true"><div class="ribbon-track">
        {[0, 1].map(() => WORDS.map((w, i) => <span style={`color:${COLS[i % COLS.length]}`}>{w}<b>✦</b></span>))}
      </div></div>
      <h2 class="display">Got something rough?</h2>
      <div class="btns">
        <a class="btn" href="/contact/"><Send size={18} /> Start a project</a>
        <a class="btn line" href="https://arkivelabs.com" target="_blank" rel="noopener"><Globe size={18} /> arkivelabs.com</a>
      </div>
      <small class="mono">
        <span>Yohan Wickramasinghe, Colombo, Sri Lanka</span>
        <span class="socials">
          <a href="https://www.linkedin.com/in/yohan-wickramasinghe/" target="_blank" rel="noopener"><Link2 size={14} /> LinkedIn</a>
          <a href="https://www.instagram.com/_.exacdaktylos._/" target="_blank" rel="noopener"><Camera size={14} /> Instagram</a>
        </span>
      </small>
    </footer>
  )}
</body>
</html>
