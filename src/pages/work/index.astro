---
import Base from '../../layouts/Base.astro';
import WorkGrid from '../../components/WorkGrid';
import { ORDER, CARDS, P, FILTERS, asset } from '../../data/site';
const cards = ORDER.map(s => { const c = CARDS[s]; return { slug: s, category: c.category, cat: c.cat, year: P[s].year, title: c.title, desc: c.desc, tags: c.tags, img: asset(c.img) }; });
---
<Base title="Brand & Campaign Case Studies | Yohan Wickramasinghe" desc="Case studies in employer branding, campaigns, events and brand design by Yohan Wickramasinghe, with the thinking behind each one." current="work">
  <section class="page-head"><h1 class="display">Work</h1><p class="sub">Employer branding, campaigns, events and identity, each with the thinking behind it.</p></section>
  <section class="sec paper" aria-label="Projects"><WorkGrid client:load cards={cards} filters={FILTERS} /></section>
</Base>
