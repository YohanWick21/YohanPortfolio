---
import Base from '../layouts/Base.astro';
import Machine from '../components/Machine';
import Reveal from '../components/Reveal';
import StatBand from '../components/StatBand';
import { Lightbulb, PenTool, Rocket, ArrowRight, Globe, Sparkles, ArrowDown, Send } from 'lucide-react';
import { JOBS, A, dims, asset, ABOUT } from '../data/site';
const strip = [['verdentra-movie-night.jpg', 'Verdentra movie night poster', 'Movie night'], ['verdentra-poson.jpg', 'Verdentra Poson greeting post', 'Poson'], ['verdentra-interns-thesara.jpg', 'Interns, Unfiltered post', 'Interns, Unfiltered'], ['verdentra-new-joiner.jpg', 'Verdentra new joiner welcome template', 'New joiner template']];
const logo = asset('Full Logo Black.png');
const me = ABOUT.photo;
const map = [
  { n: 'Ideate', c: 'var(--sun)', Ic: Lightbulb, t: 'Strategy and positioning', d: 'Positioning and messaging that give a business a clear story.' },
  { n: 'Create', c: 'var(--pink)', Ic: PenTool, t: 'Brand and creative', d: 'Identity and campaigns that make that story look like you.' },
  { n: 'Execute', c: 'var(--sky)', Ic: Rocket, t: 'Digital and growth', d: "Websites, content and campaigns, measured so we know what works." },
];
const schema = { "@context": "https://schema.org", "@type": "Person", name: "Yohan Wickramasinghe", jobTitle: "Co-founder, Arkive Labs; Exec. Employer Branding & Comms, Verdentra", worksFor: [{ "@type": "Organization", name: "Arkive Labs", url: "https://arkivelabs.com" }, { "@type": "Organization", name: "Verdentra" }], sameAs: ["https://www.linkedin.com/in/yohan-wickramasinghe/", "https://www.instagram.com/_.exacdaktylos._/", "https://arkivelabs.com"] };
---
<Base schema={schema} title="Yohan Wickramasinghe | Brand Strategy & Employer Branding" desc="Co-founder of Arkive Labs and employer branding lead at Verdentra. Brand, campaign and design work, from first idea to published post." total={JOBS.length}>
  <section class="id-hero" aria-labelledby="h1">
    <div class="copy">
      <h1 id="h1">I turn rough ideas into brands people remember.</h1>
      <p class="lede">Co-founder at Arkive Labs. Employer branding at Verdentra.</p>
      <div class="btns"><a class="btn" href="/work/">See the work <ArrowRight size={18} /></a><a class="btn line" href="/contact/"><Send size={18} /> Start a project</a></div>
    </div>
    <div class="portrait-hero">
      <div class="frame"><img src={me.src} alt="Portrait of Yohan" width={me.w} height={me.h} fetchpriority="high" /></div>
      <a class="badge-spin" href="#press" tabindex="-1" aria-label="Jump to the press">
        <svg class="ring" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="60" fill="#C8FF00" /><defs><path id="c" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" /></defs><text font-family="Space Mono, monospace" font-size="11.5" font-weight="700" letter-spacing="2.2" fill="#070707"><textPath href="#c">IDEA TO PUBLISHED ✦ SEE HOW ✦ </textPath></text></svg>
        <span class="core"><ArrowDown size={22} /></span>
      </a>
    </div>
  </section>

  <section class="hero press" id="press" aria-labelledby="h2">
    <span class="step-tag"><Sparkles size={14} /> Try it</span>
    <h2 class="display" id="h2">From rough idea to published.</h2>
    <div class="intro">
      <p class="how"><strong>Pick a job, drag the puck,</strong> and see what I was thinking at each stage.</p>
    </div>
    <Machine client:load jobs={JOBS} />
  </section>

  <section class="sec" aria-labelledby="ak-h">
    <Reveal client:visible><div class="sec-head"><h2 class="display" id="ak-h">Same method, your brand</h2><p>The same three stages run every Arkive Labs project.</p></div></Reveal>
    <div class="map">
      {map.map((m, i) => <Reveal client:visible delay={i * 0.1}><article><span class="ico" style={`background:${m.c}`}><m.Ic size={24} strokeWidth={2.4} /></span><br /><span class="n">0{i + 1} {m.n}</span><h3 class="display">{m.t}</h3><p>{m.d}</p></article></Reveal>)}
    </div>
    <Reveal client:visible>
      <div class="ak">
        <div class="ak-logo"><img src={logo.src} alt="Arkive Labs logo" width={logo.w} height={logo.h} /></div>
        <div>
          <p class="lead">A strategy-led creative and digital studio in Colombo.</p>
          <div class="btns"><a class="btn" href="/arkive-labs/"><Sparkles size={18} /> The studio</a><a class="btn line" href="https://arkivelabs.com" target="_blank" rel="noopener"><Globe size={18} /> Visit arkivelabs.com</a></div>
        </div>
      </div>
    </Reveal>
  </section>

  <section class="sec paper" aria-labelledby="v-h">
    <Reveal client:visible><div class="sec-head"><h2 class="display" id="v-h">Inside Verdentra</h2><p>The same press, running every week on a live employer brand.</p></div></Reveal>
    <StatBand client:visible href="/work/verdentra/" caption="1 Jul to 14 Nov 2026, Verdentra social and website analytics." stats={[{ value: 250, suffix: 'K+', label: 'LinkedIn impressions' }, { value: 30, suffix: 'K+', label: 'Instagram views' }, { value: 15, suffix: 'K+', label: 'Website sessions' }]} />
    <ul class="roles"><li>Exec. Employer Branding &amp; Comms</li><li>Social media</li><li>Internal comms</li></ul>
    <div class="v-grid">
      {strip.map(([s, a, c]) => <figure><a class="proof" href="/work/verdentra/"><img src={A(s)} alt={a} width={dims(s).w} height={dims(s).h} loading="lazy" /></a><figcaption class="mono">{c}</figcaption></figure>)}
    </div>
    <div class="btns" style="margin-top:2.4rem"><a class="btn" style="background:var(--ink);border-color:var(--ink);color:var(--stock)" href="/work/">See all work <ArrowRight size={18} /></a></div>
  </section>
</Base>
